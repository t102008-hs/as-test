# ===== 只在 Vercel 的 Environment Variables 設定（伺服器端，絕不要加 VITE_ 前綴）=====
GAS_API_URL=https://script.google.com/macros/s/xxxxxxxx/exec
API_SECRET_TOKEN=與 Apps Script「指令碼屬性」API_SECRET_TOKEN 相同
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
TURNSTILE_SECRET_KEY=Cloudflare Turnstile 的 Secret Key

# ===== 以下兩個本來就是公開值（會進前端），一定要加 VITE_ 前綴 =====
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
VITE_TURNSTILE_SITE_KEY=Cloudflare Turnstile 的 Site Key

# 本機開發可用 Cloudflare 官方測試金鑰（永遠通過）：
# VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
